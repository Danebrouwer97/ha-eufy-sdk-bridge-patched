diff --git a/test/live-audio-talk.test.mjs b/test/live-audio-talk.test.mjs
new file mode 100644
index 0000000..f470e03
--- /dev/null
+++ b/test/live-audio-talk.test.mjs
@@ -0,0 +1,283 @@
+// /audio and /talk, driven over a real loopback HTTP connection against a fake camera.
+//
+// - Audio only rides along on a live view: with no /stream open it never touches the camera, and it ends
+//   when the camera's last /stream does, so it can't hold a battery camera awake by itself.
+// - The first frame decides the output: AAC-LC passes through as ADTS, A-law gets a WAV header.
+// - Talk needs a live view too, plays only for allowed callers, and feeds the body through the encoder
+//   into the camera's talkback.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import http from "node:http";
+import { EventEmitter } from "node:events";
+import { PassThrough, Writable } from "node:stream";
+
+import { loadConfig } from "../src/config.mjs";
+import { createState } from "../src/state.mjs";
+import { addressMatcher, DEFAULT_TALK_ALLOW } from "../src/talkback-route.mjs";
+
+process.env.BRIDGE_STREAM_CONSUMER_LOG_MS = "0";
+const { createHttpHandler } = await import("../src/http-routes.mjs");
+
+async function until(cond, what) {
+  for (let i = 0; i < 300; i++) {
+    if (cond()) return;
+    await new Promise((r) => setTimeout(r, 10));
+  }
+  assert.fail(`timed out waiting for: ${what}`);
+}
+
+function fakeConsumer() {
+  const c = new EventEmitter();
+  c.stopped = false;
+  c.stop = () => {
+    if (c.stopped) return;
+    c.stopped = true;
+    c.emit("stop");
+  };
+  c.pause = () => {};
+  c.resume = () => {};
+  return c;
+}
+
+function fakeTalk(codec = "aac-lc") {
+  const h = new EventEmitter();
+  h.codec = codec;
+  h.pending = 0;
+  h.received = [];
+  h.stopped = 0;
+  h.writable = () =>
+    new Writable({
+      write(chunk, _enc, cb) {
+        h.received.push(chunk);
+        cb();
+      },
+      final(cb) {
+        cb();
+        setImmediate(() => h.emit("finished"));
+      },
+    });
+  h.stop = async () => {
+    if (h.stopped++) return;
+    h.emit("stop");
+  };
+  return h;
+}
+
+/** An identity "encoder": what goes into stdin comes out of stdout. */
+function fakeEncoder(t) {
+  return (format) => {
+    const child = new EventEmitter();
+    child.format = format;
+    child.stdin = new PassThrough();
+    child.stdout = new PassThrough();
+    child.stdin.pipe(child.stdout);
+    child.stdout.on("end", () => setImmediate(() => child.emit("exit", 0)));
+    t.encoders.push(child);
+    return child;
+  };
+}
+
+async function setup({ talkAllow } = {}) {
+  const config = loadConfig({ EUFY_EMAIL: "x@y.z", EUFY_PASSWORD: "pw" });
+  if (talkAllow) config.cfg.talkAllow = talkAllow;
+  const state = createState();
+  state.flags.ready = true;
+  const t = { state, feeds: [], consumers: [], talks: [], encoders: [], liveCalls: 0, talkCodec: "aac-lc" };
+  const camera = {
+    openReadable: async () => {
+      const feed = new PassThrough();
+      t.feeds.push(feed);
+      return feed;
+    },
+    live: async () => {
+      t.liveCalls++;
+      const c = fakeConsumer();
+      t.consumers.push(c);
+      return c;
+    },
+    talkback: async () => {
+      const h = fakeTalk(t.talkCodec);
+      t.talks.push(h);
+      return h;
+    },
+  };
+  const client = { getDevice: async () => ({ camera: () => camera }) };
+  const ctx = {
+    ...config,
+    state,
+    eventImageDir: undefined,
+    eventLog: () => {},
+    broadcast: () => {},
+    noteStreamOpened: () => {},
+    noteStreamFailure: () => {},
+    streamBackoffMs: () => 0,
+    dropStreamClient: () => {},
+    streamClientFor: async () => client,
+    audioWaitForVideoMs: 300,
+    audioFirstFrameMs: 300,
+    spawnTalkEncoder: fakeEncoder(t),
+  };
+  const handler = createHttpHandler(ctx);
+  const server = http.createServer((req, res) => void handler(req, res));
+  await new Promise((r) => server.listen(0, "127.0.0.1", r));
+  t.port = server.address().port;
+  t.close = () => {
+    server.closeAllConnections();
+    return new Promise((r) => server.close(r));
+  };
+  return t;
+}
+
+/** GET a path and collect the response. */
+function get(t, path) {
+  const out = { chunks: [], ended: false };
+  out.req = http.get({ host: "127.0.0.1", port: t.port, path });
+  out.done = new Promise((resolve) => {
+    out.req.on("response", (res) => {
+      out.status = res.statusCode;
+      out.contentType = res.headers["content-type"];
+      res.on("data", (c) => out.chunks.push(c));
+      res.on("end", () => resolve(Object.assign(out, { ended: true })));
+      res.on("error", () => resolve(out));
+    });
+    out.req.on("error", () => resolve(out));
+  });
+  return out;
+}
+
+/** POST `chunks` (written one by one) to a path; resolves with status and parsed JSON. */
+function post(t, path, chunks) {
+  return new Promise((resolve, reject) => {
+    const req = http.request({ host: "127.0.0.1", port: t.port, path, method: "POST" }, (res) => {
+      let body = "";
+      res.on("data", (c) => (body += c));
+      res.on("end", () => resolve({ status: res.statusCode, body: body ? JSON.parse(body) : undefined }));
+    });
+    req.on("error", reject);
+    for (const c of chunks) req.write(c);
+    req.end();
+  });
+}
+
+const body = (out) => Buffer.concat(out.chunks);
+
+test("audio without a live view is refused and never opens the camera", async () => {
+  const t = await setup();
+  try {
+    const out = await get(t, "/audio/CAM1").done;
+    assert.equal(out.status, 503);
+    assert.equal(t.liveCalls, 0);
+  } finally {
+    await t.close();
+  }
+});
+
+test("AAC-LC audio passes through as ADTS while the camera is watched, and ends with the video", async () => {
+  const t = await setup();
+  try {
+    const video = get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    const audio = get(t, "/audio/CAM1");
+    await until(() => t.consumers.length === 1, "audio consumer attached");
+    t.consumers[0].emit("audio", { codec: "aac-lc", data: Buffer.from([0xff, 0xf1, 1, 2]) });
+    t.consumers[0].emit("audio", { codec: "aac-lc", data: Buffer.from([0xff, 0xf1, 3, 4]) });
+    await until(() => audio.chunks.length > 0 && body(audio).length === 8, "audio bytes arrive");
+    assert.equal(audio.status, 200);
+    assert.equal(audio.contentType, "audio/aac");
+
+    t.feeds[0].end(); // the last viewer leaves
+    const done = await audio.done;
+    assert.equal(done.ended, true);
+    assert.equal(t.consumers[0].stopped, true, "the audio consumer stops with the video");
+    await video.done;
+  } finally {
+    await t.close();
+  }
+});
+
+test("A-law audio is wrapped in a streaming WAV header", async () => {
+  const t = await setup();
+  try {
+    get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    const audio = get(t, "/audio/CAM1");
+    await until(() => t.consumers.length === 1, "audio consumer attached");
+    t.consumers[0].emit("audio", { codec: "g711a", data: Buffer.alloc(160, 0xd5) });
+    await until(() => body(audio).length === 44 + 160, "header and samples arrive");
+    const b = body(audio);
+    assert.equal(audio.contentType, "audio/wav");
+    assert.equal(b.toString("ascii", 0, 4), "RIFF");
+    assert.equal(b.readUInt16LE(20), 6, "WAVE_FORMAT_ALAW");
+    assert.equal(b.readUInt32LE(24), 16000);
+    t.feeds[0].end();
+  } finally {
+    await t.close();
+  }
+});
+
+test("a camera that sends no audio gets a 404 and its consumer is released", async () => {
+  const t = await setup();
+  try {
+    get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    const out = await get(t, "/audio/CAM1").done;
+    assert.equal(out.status, 404);
+    assert.equal(t.consumers[0].stopped, true);
+    t.feeds[0].end();
+  } finally {
+    await t.close();
+  }
+});
+
+test("talk feeds the body through the encoder into the camera's talkback", async () => {
+  const t = await setup();
+  try {
+    get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    const r = await post(t, "/talk/CAM1", [Buffer.alloc(3200, 1), Buffer.alloc(3200, 2)]);
+    assert.equal(r.status, 200);
+    assert.equal(r.body.ok, true);
+    assert.equal(r.body.bytes, 6400);
+    assert.equal(t.encoders[0].format, "s16le");
+    assert.equal(Buffer.concat(t.talks[0].received).length, 6400);
+    assert.ok(t.talks[0].stopped >= 1, "the talk is closed afterwards");
+    t.feeds[0].end();
+  } finally {
+    await t.close();
+  }
+});
+
+test("talk is refused without a live view, for an unknown format, and for a speaker it can't encode for", async () => {
+  const t = await setup();
+  try {
+    assert.equal((await post(t, "/talk/CAM1", [Buffer.alloc(10)])).status, 409);
+    get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    assert.equal((await post(t, "/talk/CAM1?format=mp3", [Buffer.alloc(10)])).status, 400);
+    t.talkCodec = "aac-eld";
+    assert.equal((await post(t, "/talk/CAM1", [Buffer.alloc(10)])).status, 415);
+    assert.equal(t.talks[0].stopped, 1, "the refused talk is closed");
+    t.feeds[0].end();
+  } finally {
+    await t.close();
+  }
+});
+
+test("talk is refused for callers outside BRIDGE_TALK_ALLOW", async () => {
+  const t = await setup({ talkAllow: "10.0.0.0/8" });
+  try {
+    get(t, "/stream/CAM1");
+    await until(() => t.feeds.length === 1, "video feed open");
+    assert.equal((await post(t, "/talk/CAM1", [Buffer.alloc(10)])).status, 403);
+    assert.equal(t.talks.length, 0, "the camera's speaker is never opened");
+    t.feeds[0].end();
+  } finally {
+    await t.close();
+  }
+});
+
+test("the default allow list covers loopback and the Supervisor network, not the LAN", () => {
+  const ok = addressMatcher(DEFAULT_TALK_ALLOW);
+  for (const ip of ["127.0.0.1", "::1", "::ffff:127.0.0.1", "172.30.32.1", "172.30.33.5"]) assert.ok(ok(ip), ip);
+  for (const ip of ["192.168.1.50", "10.0.0.2", "172.30.34.1", "::ffff:192.168.1.2", ""]) assert.ok(!ok(ip), ip);
+});
